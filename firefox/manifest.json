{
  "manifest_version": 3,
  "name": "SN Assignflow",
  "version": "4.0.0",
  "description": "Round-robin auto-assignment for ServiceNow. Configure agents by user ID, keep your session alive, and dispatch from a widget on the instance itself.",
  "homepage_url": "https://github.com/aryanarin/assignflow",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SN Assignflow",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "config.html",
    "open_in_tab": true
  },
  "background": {
    "scripts": [
      "shared.js",
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "assignflow@arinraj09",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "*://*.service-now.com/*"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.service-now.com/*"
      ],
      "js": [
        "shared.js",
        "widget.js"
      ],
      "css": [
        "widget.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
